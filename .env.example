# Database (Neon-ready; local default shown)
DATABASE_URL="postgresql://gymverse_dev:gymverse_dev@localhost:5432/gymverse?schema=public"

# API
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development

# Auth — generate a long random string in production
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="gymverse_token"
COOKIE_SECURE="false"

# CORS — web origin(s), comma-separated
CORS_ORIGIN="http://localhost:3000"

# Notifications cron (minutes)
NOTIFICATION_CRON_MINUTES=15

# Optional SMTP (omit to log emails to console)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Gymverse <noreply@gymverse.app>"

# Optional Cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Web (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
